<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog" android:orientation="vertical">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@drawable/bg_dialog_header" android:orientation="vertical" android:padding="22dp">
        <TextView android:id="@+id/dialogTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="افزودن تولد" android:textColor="@android:color/white" android:textSize="22sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
            android:text="اطلاعات فرد و تاریخ تولد شمسی را وارد کنید" android:textColor="@color/purple_100" android:textSize="13sp" />
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="18dp">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="نام و نام خانوادگی"
                app:boxCornerRadiusTopStart="14dp" app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp" app:boxCornerRadiusBottomEnd="14dp"
                app:boxStrokeColor="@color/purple_700" app:hintTextColor="@color/purple_700">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/inputName"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPersonName" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp"
                android:text="تاریخ تولد (شمسی)" android:textColor="@color/text_secondary" android:textSize="13sp" />

            <LinearLayout android:id="@+id/dateBox" android:layout_width="match_parent" android:layout_height="56dp"
                android:layout_marginTop="6dp" android:background="@drawable/bg_date_box" android:clickable="true" android:focusable="true"
                android:foreground="?attr/selectableItemBackground" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="16dp">
                <TextView android:id="@+id/dateText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:textColor="@color/text_primary" android:textSize="17sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📅 تغییر" android:textColor="@color/purple_700" />
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:hint="یادداشت (اختیاری)"
                app:boxCornerRadiusTopStart="14dp" app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp" app:boxCornerRadiusBottomEnd="14dp"
                app:boxStrokeColor="@color/purple_700" app:hintTextColor="@color/purple_700">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/inputNote"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapSentences|textMultiLine" android:maxLines="3" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView android:id="@+id/formError" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:textColor="@color/error" android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="16dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/btnSave" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1"
            android:text="ذخیره" app:cornerRadius="16dp" app:backgroundTint="@color/purple_700" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnCancel" style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:layout_marginStart="10dp"
            android:text="انصراف" android:textColor="@color/purple_700" app:cornerRadius="16dp" />
    </LinearLayout>
</LinearLayout>
